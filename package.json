{
  "name": "ftr",
  "version": "1.0.0",
  "private": true,
  "description": "First Time Resolver — IT Solutions & Services website",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "npm run lint && npm run spell && npm run check:site && npm test && npm run build:check",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"dist/**/*.css\"",
    "lint:html": "html-validate \"dist/**/*.html\"",
    "spell": "cspell --no-progress --show-suggestions",
    "grammar": "node scripts/check-grammar.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:live": "node scripts/check-live.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "playwright test",
    "build:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "security:vendor": "retire --path dist --severity low --exitwith 1",
    "predeploy": "npm run check",
    "deploy": "wrangler deploy --assets=./dist",
    "pages:deploy": "wrangler pages deploy dist"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "cspell": "10.4.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "html-validate": "11.17.0",
    "parse5": "8.0.1",
    "retire": "6.1.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "wrangler": "4.154.0"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
