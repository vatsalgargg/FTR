{
  "$schema": "https://html-validate.org/schemas/config.json",
  "extends": ["html-validate:recommended", "html-validate:a11y", "html-validate:document"],
  "rules": {
    "doctype-style": "off",
    "no-raw-characters": ["error", { "relaxed": true }],
    "prefer-native-element": ["error", { "exclude": ["region"] }],
    "no-inline-style": ["error", { "allowedProperties": [] }],
    "no-style-tag": "error",
    "require-sri": "off"
  }
}
